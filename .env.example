# ==============================================================
# VOWS & VENUES — STAGING & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================
# IMPORTANT:
# - Do NOT commit actual credentials or connection strings to git.
# - On Render, configure these in: Service Dashboard -> Environment -> Environment Variables.
# ==============================================================

# Node runtime & server port
NODE_ENV=production
PORT=10000

# Primary Durable Database (MongoDB Atlas / Render MongoDB)
# For Render Staging: Set USE_LOCAL_DB=false and provide MONGODB_URI
USE_LOCAL_DB=false
MONGODB_URI=mongodb+srv://<staging_user>:<staging_password>@<cluster>.mongodb.net/vows_and_venues_staging?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<staging_user>:<staging_password>@<cluster>.mongodb.net/vows_and_venues_staging?retryWrites=true&w=majority
DB_NAME=vows_and_venues_staging

# Authentication & Session Security (Generate with: openssl rand -hex 32)
JWT_SECRET=your_staging_jwt_secret_minimum_64_characters_entropy_here
ADMIN_SECRET=your_staging_admin_creation_secret_token_here
SEED_KEY=your_staging_database_seed_authorization_key_here

# Network, Origins & URLs
NEXT_PUBLIC_BASE_URL=https://vowsandvenues-staging.onrender.com
CORS_ORIGINS=https://vowsandvenues-staging.onrender.com,https://vowsandvenues.in

# Marketplace Business Rules
REQUIRE_COMPLETED_BOOKING_FOR_REVIEW=false

# Optional Integrations (Disabled safely if left blank)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
